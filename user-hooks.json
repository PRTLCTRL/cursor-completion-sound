{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"./hooks/play-completion-sound.ps1\"",
        "timeout": 8
      }
    ],
    "afterAgentResponse": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"./hooks/play-completion-sound.ps1\"",
        "timeout": 8
      }
    ],
    "subagentStop": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"./hooks/play-completion-sound.ps1\"",
        "timeout": 8
      }
    ]
  }
}
